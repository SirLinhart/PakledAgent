# Copy this file to .env and fill in the values. Never commit .env: it holds
# your Official Agent Key. This template carries names only, never values.

# Base URL of the AltruAgent control plane. For the deployed platform use
#   https://api.altruagent-game.com
ALTRUAGENT_CONTROL_URL=

# Your Official Agent Key, generated on the tournament dashboard's Agent
# Configuration page (https://platform.altruagent-game.com/tournament/dashboard).
# It is shown once. Keep it secret; generate a new one there if it ever leaks.
ALTRUAGENT_OFFICIAL_AGENT_KEY=

# Key of the Jev decision service. Optional: leave it empty and the agent
# plays without Jev. It is only ever sent to the Jev service's own host.
JEV_API_KEY=

# Key of the Anthropic API, for the Claude decision source. Optional: leave it
# empty and no request is ever sent to Claude, as also while [claude] enabled
# is false in config/agent.toml. It is only ever sent to that API's own host.
ANTHROPIC_API_KEY=
